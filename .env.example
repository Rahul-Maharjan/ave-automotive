# Copy this file to `.env` (or set these in your hosting provider's dashboard)
# before running a production build.

# Public origin of the deployed site, without a trailing slash.
# Used for canonical URLs, Open Graph tags, and the generated sitemap.
VITE_SITE_URL=https://aveautomotive.com.np

# Admin API base URL used by the frontend and the sitemap generator.
VITE_API_BASE_URL=https://aveautomotive.com.np/admin/api

# Optional: path prefix the app is served from. Defaults to Vite's `base` ("/new").
# VITE_BASE_PATH=/new
