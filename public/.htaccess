# ─────────────────────────────────────────────────────────────────────────────
# AVE Automotives — Apache configuration (cPanel / shared hosting)
#
# Place the contents of `dist/` inside a folder that matches Vite's `base`
# (currently `public_html/new`) and upload this file as `.htaccess` at the root
# of that folder. The rewrite below is relative, so it also works if the folder
# name changes — just keep Vite's `base` in sync.
# ─────────────────────────────────────────────────────────────────────────────

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files/directories directly (assets, images, favicon,
  # robots.txt, sitemap.xml, …).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else falls back to the SPA entry point so client-side routes
  # such as /new/blog/:slug and /new/products/:slug survive a hard refresh.
  RewriteRule ^ index.html [L]
</IfModule>

# ── Compression ───────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml font/woff2
</IfModule>

# ── Correct MIME types ────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/avif .avif
  AddType image/webp .webp
</IfModule>

# ── Caching & security headers ───────────────────────────────────────────────
<IfModule mod_headers.c>
  # Fingerprinted build assets can be cached aggressively.
  <FilesMatch "\.(js|css|woff2?|ttf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # The HTML shell must always be revalidated so new releases are picked up.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
